# --- Trading mode safety switch ---
# paper is the only mode that runs without extra confirmation.
# To go live BOTH of these must be set, otherwise the system refuses to execute (read-only).
TRADING_MODE=paper
LIVE_CONFIRM=

# --- IB Gateway connection ---
# Defaults match the gnzsnz/ib-gateway image used by docker-compose.yml
# (paper=4004, live=4003). Running IB Gateway/TWS directly on a dev machine
# instead (DEPLOY.md option B) usually means paper=4002, live=4001 -- change
# this to match whatever you're actually pointing at.
IB_HOST=127.0.0.1
IB_PORT=4004
IB_CLIENT_ID=17

# IBC credentials (paper account only unless you know what you're doing)
TWS_USERID=
TWS_PASSWORD=

# --- AI layer (advisory only, never bypasses risk/guard.py) ---
ANTHROPIC_API_KEY=

# --- Telegram alerts + /kill /resume /status commands ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web terminal ---
WEB_AUTH_TOKEN=change-me
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Storage ---
DATABASE_URL=sqlite:///./data/omega.db

# --- Risk limits (hard caps, config only tightens further at runtime) ---
MAX_DAILY_LOSS_PCT_NAV=0.02
MAX_POSITION_PCT_NAV=0.10
MAX_OPEN_POSITIONS=8
MAX_ORDER_NOTIONAL=25000
MAX_OPTIONS_CONTRACTS_PER_ORDER=10
